{
  "name": "token-vocabs",
  "version": "0.7.0",
  "type": "module",
  "description": "Count and inspect token IDs across several modern tokenizer families offline.",
  "keywords": [
    "bpe",
    "count-tokens",
    "deepseek",
    "gemma",
    "gpt",
    "kimi",
    "llm",
    "minimax",
    "qwen",
    "sdxl",
    "tokenizer"
  ],
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/token-vocabs.git"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./browser": {
      "types": "./src/browser/main.ts",
      "import": "./src/browser/main.ts",
      "default": "./src/browser/main.ts"
    },
    "./browser/all": {
      "types": "./src/browser/all.ts",
      "import": "./src/browser/all.ts",
      "default": "./src/browser/all.ts"
    }
  },
  "imports": {
    "#tiktoken": {
      "browser": "./src/browser/tiktoken.ts",
      "default": "./src/lib/tiktoken.ts"
    },
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run ensure-data && bun scripts/build.ts",
    "ensure-data": "bun scripts/ensureData.ts",
    "fetch": "bun scripts/fetch.ts",
    "lint": "bun run ensure-data && bun x eslint .",
    "test": "bun test --max-concurrency 1 ./test",
    "test:distribution": "bun scripts/testDistribution.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "brotli": "1.3.3",
    "forward-slash-path": "0.3.0",
    "msgpackr": "2.1.0",
    "tiktoken": "1.0.22"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "eslint": "10.9.1",
    "eslint-config-jaid": "26.0.0",
    "fs-extra": "11.4.0",
    "markdown-map": "0.3.0",
    "rolldown": "1.2.6",
    "rolldown-plugin-wasm": "0.3.2",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "files": [
    "src",
    "temp/generated",
    "license.txt",
    "readme.md"
  ],
  "private": true
}
